<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Necesario para que ExoPlayer ajuste buffers y Coil detecte cambios de red. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Requerido para MediaSessionService en background. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <!-- Runtime request en MainActivity.requestNotificationPermission(). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- READ_EXTERNAL_STORAGE solo en API <= 32; READ_MEDIA_AUDIO en API 33+. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />

    <!-- La app requiere salida de audio. Filtra Play Store en dispositivos sin altavoz. -->
    <uses-feature
        android:name="android.hardware.audio.output"
        android:required="true" />

    <application
        android:name=".PrismApplication"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Prism">

        <!--
            launchMode=singleTop + onNewIntent en MainActivity: evita recrear
            la Activity cuando el usuario vuelve desde la notificación.
            windowSoftInputMode=adjustNothing: el IME se maneja en Compose
            con Modifier.imePadding() en cada pantalla con TextField.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.App.Starting"
            android:windowSoftInputMode="adjustNothing">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            exported=true es necesario para:
              - Recibir MEDIA_BUTTON de Bluetooth/cascos.
              - Ser controlado por Android Auto, Wear OS, Asistente.
            La seguridad real la proporciona MediaSession.Callback.onConnect()
            en PlaybackService, que filtra controladores legítimos.
        -->
        <service
            android:name=".player.PlaybackService"
            android:label="@string/app_name"
            android:foregroundServiceType="mediaPlayback"
            android:exported="true"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </service>

    </application>

</manifest>